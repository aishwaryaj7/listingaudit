# Copy to .env to override the defaults.
# Read by docker-compose.yml and listingaudit.config.
POSTGRES_USER=listingaudit
POSTGRES_PASSWORD=listingaudit
POSTGRES_DB=listingaudit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Read-only role for the agent, created by listingaudit.market.build.
# It has no access to the answer_key schema.
AGENT_DB_USER=listingaudit_agent
AGENT_DB_PASSWORD=listingaudit_agent

# Vision language model for photos CLIP can't settle (optional; each photo costs a
# little). For Azure OpenAI, use the resource's v1 endpoint and the deployment name;
# for the OpenAI API, leave VISION_BASE_URL out.
# VISION_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
# VISION_API_KEY=
# VISION_MODEL=gpt-5-mini

# The agent's language models, on the same endpoint and key as the vision model.
# The large model (optional) takes over a draft report the small one can't get past
# the self-check.
# AGENT_MODEL=gpt-5-mini
# AGENT_MODEL_LARGE=
