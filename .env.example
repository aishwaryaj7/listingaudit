# Copy this file to .env and change the values if you like.
# docker-compose.yml and the Python code both read these.
POSTGRES_USER=listingaudit
POSTGRES_PASSWORD=listingaudit
POSTGRES_DB=listingaudit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# The agent's own database login. It can read the marketplace (schema "market")
# but not the answer key. listingaudit.market.build creates it.
AGENT_DB_USER=listingaudit_agent
AGENT_DB_PASSWORD=listingaudit_agent
