# Copy to .env to override the defaults.
# Read by docker-compose.yml and listingaudit.config.
POSTGRES_USER=listingaudit
POSTGRES_PASSWORD=listingaudit
POSTGRES_DB=listingaudit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Read-only role for the agent, created by listingaudit.market.build.
# It has no access to the answer_key schema.
AGENT_DB_USER=listingaudit_agent
AGENT_DB_PASSWORD=listingaudit_agent
