# Copy to .env to override the defaults.
# Read by docker-compose.yml and listingaudit.config.
POSTGRES_USER=listingaudit
POSTGRES_PASSWORD=listingaudit
POSTGRES_DB=listingaudit
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Read-only role for the agent, created by listingaudit.market.build.
# It has no access to the answer_key schema.
AGENT_DB_USER=listingaudit_agent
AGENT_DB_PASSWORD=listingaudit_agent

# Vision language model for photos CLIP can't settle (optional; each photo costs a
# little). For Azure OpenAI, use the resource's v1 endpoint and the deployment name;
# for the OpenAI API, leave VISION_BASE_URL out.
# VISION_BASE_URL=https://<resource>.openai.azure.com/openai/v1/
# VISION_API_KEY=
# VISION_MODEL=gpt-5-mini

# The agent's language models, on the same endpoint and key as the vision model.
# The large model (optional) takes over a draft report the small one can't get past
# the self-check.
# AGENT_MODEL=gpt-5-mini
# AGENT_MODEL_LARGE=

# The model that grades the reports' clarity and fairness in the evaluation (the
# agent's model by default; a different model avoids a model grading its own writing).
# JUDGE_MODEL=

# Where the review service keeps the audit log and the paused audits (a schema of its
# own), and where the review screen finds the review API.
# REVIEW_SCHEMA=review
# API_URL=http://127.0.0.1:8000

# A password for the review screen (optional here; the Azure deployment always sets one)
# SCREEN_PASSWORD=

# Listing photos from Azure Blob Storage instead of data/images (optional; the Azure
# deployment sets these): the storage account's blob address, reached with az login or
# a managed identity, or a connection string with a key, such as Azurite's.
# PHOTOS_ACCOUNT_URL=https://<account>.blob.core.windows.net/
# PHOTOS_CONNECTION_STRING=
# PHOTOS_CONTAINER=photos

# Tracing with Langfuse (optional): the keys of a Langfuse project. Langfuse Cloud in
# the EU is the default; set LANGFUSE_BASE_URL for another region or a self-hosted server.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
